# Optional: Application URL for public links (defaults to https://tenantflow-alpha.vercel.app in production)
NEXT_PUBLIC_APP_URL=https://tenantflow-alpha.vercel.app

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SECRET_KEY=your-secret-key

# Optional: JWKS endpoint for token validation
SUPABASE_JWKS_URL=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json

# Background worker bearer token
CRON_SECRET=

# Upstash Redis delayed retry queue. Supabase retains durable delivery records.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
